---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Tabs from "../components/Tabs.astro";
---

<Base skipTo="calculator">
  <Header />
  <main id="calculator" class="container" tabindex="-1">
    <noscript><p class="noscript">These calculators need JavaScript. Nothing you type is sent anywhere.</p></noscript>
    <Tabs>
      <div slot="dca"><h2 class="panel-title glow">DCA Plan</h2></div>
      <div slot="be"><h2 class="panel-title glow">Break-even</h2></div>
      <div slot="dd"><h2 class="panel-title glow">Drawdown</h2></div>
    </Tabs>
  </main>
  <Footer />
  <script>
    import "../scripts/main.ts";
  </script>
</Base>
